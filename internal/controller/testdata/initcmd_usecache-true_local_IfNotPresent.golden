mkdir -p "$CACHE_DIR" || exit 1; exec 9>"$CACHE_DIR/.llmkube-download.lock" || exit 1; if ! flock -n 9; then echo 'Waiting for the download lock held by another pod...'; flock 9 || { echo "ERROR: could not lock $CACHE_DIR/.llmkube-download.lock; the init image must provide flock" >&2; exit 1; }; fi; rm -f "$MODEL_PATH.tmp" && if [ ! -f "$MODEL_PATH" ]; then echo 'Copying model from local source...'; cp /host-model/model.gguf "$MODEL_PATH.tmp" && mv "$MODEL_PATH.tmp" "$MODEL_PATH" && echo 'Model copied successfully'; else echo 'Model already cached, skipping copy'; fi